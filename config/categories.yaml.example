categories:
  # Income
  - name: Salary
    is_income: true
  - name: Airbnb Income
    is_income: true
  - name: Freelance Income
    is_income: true
  - name: Interest Income
    is_income: true
  - name: Other Income
    is_income: true

  # Business (ATO deductible)
  - name: "Business: Hosting & Infrastructure"
  - name: "Business: Software & Subscriptions"
  - name: "Business: Equipment"
  - name: "Business: Advertising & Marketing"
  - name: "Business: Other"

  # Rental Property (ATO deductible)
  - name: "Rental: Maintenance"
  - name: "Rental: Other"

  # Housing
  - name: Rent
  - name: Utilities
    budget_monthly: 300
  - name: Insurance
  - name: Strata

  # Food & Drink
  - name: Groceries
    budget_monthly: 600
  - name: Eating Out
    budget_monthly: 300
  - name: Coffee
    budget_monthly: 80

  # Transport
  - name: Public Transport
    budget_monthly: 150
  - name: Fuel
  - name: Car
  - name: Tolls

  # Shopping
  - name: Clothing
  - name: Electronics
  - name: Home & Garden
  - name: Shopping

  # Health
  - name: Health
    budget_monthly: 200
  - name: Fitness

  # Entertainment
  - name: Subscriptions
    budget_monthly: 100
  - name: Entertainment

  # Financial
  - name: Transfers
    kind: neutral
  # Money in that is neither earned nor a refund: family money, gifts.
  - name: Personal (non-assessable)
    kind: neutral
  # An employer paying back what you spent for it (an expense claim). Link the
  # refund to the purchase when it repays one thing; otherwise file it here.
  - name: Employer Reimbursements
    kind: neutral
  - name: Fees & Charges
  - name: Cash Withdrawal
  - name: Investments
    kind: neutral

  # Mortgage
  - name: Mortgage

  # Tax (ATO payments and refunds)
  - name: Tax

  # Other
  - name: Uncategorized

# =============================================================================
# SOURCE RULES — every row from a source belongs to one category.
# These run before anything else. Merchants are filed under `merchants:` below.
# =============================================================================
rules:
  - type: source
    source_type: airbnb
    category: Airbnb Income

# =============================================================================
# MERCHANTS — "description as it appears on a statement": Category
#
# These seed the categoriser before it has seen your own filing. Receipt
# numbers, dates, card digits, reference codes and trailing suburbs/states are
# ignored, so "WOOLWORTHS 1234 SYDNEY NS" and "WOOLWORTHS" are the same merchant.
# A merchant you have never listed is filed like the most similar ones you
# have, so a few examples per category go a long way. Changing a category in
# the dashboard always wins over this list.
# =============================================================================
merchants:
  # --- Business ---
  NAMECHEAP.COM: "Business: Hosting & Infrastructure"
  ICDSOFT: "Business: Hosting & Infrastructure"
  DIGITALOCEAN.COM: "Business: Hosting & Infrastructure"
  HEROKU: "Business: Hosting & Infrastructure"
  CLOUDFLARE: "Business: Hosting & Infrastructure"
  AMAZON WEB SERVICES: "Business: Hosting & Infrastructure"
  TWILIO: "Business: Software & Subscriptions"
  GOOGLE GSUITE: "Business: Software & Subscriptions"
  GITHUB.COM: "Business: Software & Subscriptions"
  GITLAB: "Business: Software & Subscriptions"
  JETBRAINS: "Business: Software & Subscriptions"
  FIGMA: "Business: Software & Subscriptions"
  CANVA: "Business: Software & Subscriptions"
  ADOBE: "Business: Software & Subscriptions"
  OPENAI: "Business: Software & Subscriptions"
  ANTHROPIC: "Business: Software & Subscriptions"

  # --- Tax ---
  ATO PAYMENT: Tax
  AUSTRALIAN TAXATION OFFICE: Tax

  # --- Income ---
  SALARY DEPOSIT EMPLOYER PTY LTD: Salary
  INTEREST CREDIT: Interest Income
  CREDIT BONUS INTEREST: Interest Income
  AIRBNB PAYMENTS: Airbnb Income

  # --- Transfers ---
  TRANSFER TO OTHER ACCOUNT: Transfers
  TRANSFER FROM OTHER ACCOUNT: Transfers
  INTERNAL TRANSFER: Transfers
  BPAY BILL PAYMENT: Transfers

  # --- Fees and mortgage ---
  INTEREST CHARGED: Fees & Charges
  ANNUAL FEE: Fees & Charges
  BANK CHEQUE FEE: Fees & Charges
  OVERDRAFT FEE: Fees & Charges
  MORTGAGE OFFSET: Mortgage
  TRANSFER OFFSET FACILITY: Mortgage
  INTEREST CHARGE HOME LOAN: Mortgage

  # --- Groceries ---
  WOOLWORTHS: Groceries
  COLES: Groceries
  ALDI STORES: Groceries
  IGA: Groceries
  HARRIS FARM MARKETS: Groceries
  COSTCO WHOLESALE: Groceries
  LIQUORLAND: Groceries
