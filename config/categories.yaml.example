  CASH WITHDRAWAL: Cash Withdrawal

  # Add your own merchants below, copied from a statement line.

# =============================================================================
# TAG RULES — Multiple tags can match per transaction. Orthogonal to categories.
# Used for sub-classification and ATO reporting.
# =============================================================================
tag_rules:
  # Transport
  - tag: flight
    pattern: "JETSTAR|QANTAS|VIRGIN AUSTRALIA"
  - tag: taxi
    pattern: "UBER TRIP|UBER AUSTRALIA|TAXI"
  - tag: train
    pattern: "OPAL|TRANSPORTFORNSW"
  - tag: delivery
    pattern: "UBER ?EATS|DOORDASH|MENULOG|DELIVEROO"

  # Insurance
  - tag: health-insurance
    pattern: "MEDIBANK|AMBULANCE"

  # Utilities
  - tag: mobile
    pattern: "OPTUS|VODAFONE|TPG"
  - tag: internet
    pattern: "TPG"
  - tag: water
    pattern: "SYDNEY WATER"

  # Business
  - tag: biz-hosting
    pattern: "NAMECHEAP|ICDSOFT|DIGITAL ?OCEAN|CLOUDFLARE|AWS"
  - tag: biz-software
    pattern: "TWILIO|GOOGLE.?GSUITE|GITHUB|FIGMA|ADOBE"

  # Income
  - tag: salary
    pattern: "SALARY DEPOSIT"
  - tag: interest
    pattern: "INTEREST CREDIT|CREDIT BONUS INTEREST"
  - tag: rental-income
    pattern: "AIRBNB PAYMENTS"

  # Property
  - tag: mortgage
    pattern: "MORTGAGE|OFFSET FACILITY|INTEREST CHARGE"
  - tag: strata
    pattern: "STRATA|BODY CORP"

  # Tax
  - tag: tax
    pattern: "ATO PAYMENT|AUSTRALIAN TAXATION|\\bATO ATO\\d"

# --- Shared expenses (split with a partner) ---
# Marked automatically at ingest. Inclusion follows the MERCHANT, not the
# category: Optus is a utility that has never been shared, and fuel is shared on
# a road trip but not at the local servo -- so neither appears here.
# A rule never overrides a manual decision, and `from:` keeps a new rule out of
# periods already settled.
shared_rules:
  - pattern: "ORIGIN ENERGY|DODO POWER|SUPERLOOP|SYDNEY WATER"
    split_pct: 50
    exclude: "FORCE POST NO FUNDS|REVERSAL|DISHONOUR"
  - pattern: "DEFT STRATA|BAYSIDE CNCL|BAYSIDE COUNCIL"
    split_pct: 50
  - pattern: "AAMI"
    split_pct: 50
    from: "2026-08-01"    # earlier premiums are settled and stay unshared
