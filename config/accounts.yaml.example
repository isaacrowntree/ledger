accounts:
  # === Everyday / Checking Accounts ===
  # file_prefix maps statement filenames to accounts (e.g. "my_checking_2025-01.pdf")

  - name: "My Checking Account"
    source_type: ing            # Parser: ing, paypal, bankwest, hsbc, coles, amex, airbnb
    currency: AUD
    account_type: checking      # checking, savings, credit, loan, other
    file_prefix: my_checking

  - name: "My Savings"
    source_type: ing
    currency: AUD
    account_type: savings
    file_prefix: my_savings

  # === Credit Cards ===
  # source_of_truth: true means this account has the detailed transaction data.
  # payment_patterns: regex patterns that appear on OTHER accounts when paying this card.
  # This prevents double-counting (ING sees "BPAY COLES MASTERCARD" → auto-marked as transfer).

  - name: "My Credit Card"
    source_type: bankwest
    currency: AUD
    account_type: credit
    source_of_truth: true
    payment_patterns:
      - "MY CREDIT CARD"
      - "BPAY.*MY CARD"

  # === PayPal ===
  - name: "PayPal"
    source_type: paypal
    currency: AUD
    account_type: other
    source_of_truth: true
    payment_patterns:
      - "PAYPAL"

  # === Loan / Mortgage ===
  # - name: "My Mortgage"
  #   source_type: ing
  #   currency: AUD
  #   account_type: loan
  #   file_prefix: my_mortgage

  # === Commonwealth Bank ===
  # PDF statements only; drop them in staging/cba/ and staging/cba-cc/.
  # The account each statement belongs to comes from the staging directory,
  # not the filename — CBA names every download "Statement<date>.pdf".

  # - name: "CBA Smart Access"
  #   source_type: cba
  #   currency: AUD
  #   account_type: checking

  # - name: "CBA Awards Credit Card"
  #   source_type: cba-cc
  #   currency: AUD
  #   account_type: credit
  #   source_of_truth: true
  #   payment_patterns:
  #     - "Transfer to xx1234"      # how the card payment reads on Smart Access

  # === Bankwest home loan + offset ===
  # These two share a statement layout, so they are told apart by staging
  # directory: staging/bankwest-loan/ and staging/bankwest-offset/. Each
  # parser checks the statement title and refuses a file staged under the
  # wrong account. The offset's repayments to the loan appear on both
  # statements, so mark one side to avoid double-counting.

  # - name: "Bankwest Home Loan"
  #   source_type: bankwest-loan
  #   currency: AUD
  #   account_type: loan
  #   source_of_truth: true
  #   payment_patterns:
  #     - "PERIODICAL PAYMENT TO BANKWEST SIMPLE HL"

  # - name: "Bankwest Offset"
  #   source_type: bankwest-offset
  #   currency: AUD
  #   account_type: savings

  # === Airbnb (if using Airbnb CSV parser) ===
