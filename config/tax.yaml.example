financial_year: 2025  # ending June 30

taxpayer:
  name: "Your Name"
  # spouse:
  #   name: "Spouse Name"
  #   taxable_income: 0

businesses:
  - name: "My Business"
    abn: "00000000000"
    activity: "Your business activity"
    split_rules:
      # Personal categories that are partially business use
      - category: Utilities
        tag: internet
        business_pct: 50      # % of internet bill that's business use
      - category: Utilities
        tag: mobile
        business_pct: 20
    # Categories starting with "Business:" are implicitly 100% allocated

rental_properties: []
  # - name: "MY PROPERTY"
  #   address: "123 Main St, Suburb NSW 2000"
  #   ownership_pct: 100           # your legal ownership interest in the title
  #   floor_area_pct: 100          # rented portion (rent-a-room); 100 for whole-property
  #   rental_weeks: { 2025: 52 }
  #   income_category: "Airbnb Income"
  #   # apply modes multiply the gross expense, in order:
  #   #   ownership : × ownership_pct/100
  #   #   area      : × floor_area_pct/100   (private-use apportionment)
  #   #   time      : × rental_weeks/52       (part-year availability)
  #   #   []        : 100% — NO apportionment
  #   # CO-OWNERSHIP: on a property owned with someone else, EVERY expense is
  #   # split by ownership interest — repairs included (TR 93/32). Use
  #   # apply: [ownership] on every line; reserve [] for a solely-owned property.
  #   expense_mapping:
  #     - ato_label: "Body corporate fees"
  #       category: "Strata"
  #       apply: [ownership]
  #     - ato_label: "Interest on loans"
  #       category: "Mortgage"
  #       apply: [ownership, area]   # area only if rent-a-room / part of home
  #     - ato_label: "Water charges"
  #       tag: "water"
  #       apply: [ownership]
  #     - ato_label: "Repairs and maintenance"
  #       category: "Rental: Maintenance"
  #       apply: [ownership]         # still split by ownership even though rental-specific

work_deductions:
  wfh:
    rate_per_hour: 0.67        # ATO fixed rate method
    entries:
      2025: { weeks: 48, allocation_pct: 100 }

depreciation_schedules: []
